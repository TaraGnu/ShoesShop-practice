<UserControl x:Class="ShoesShop.Views.Controls.TopBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Calibri">

    <Border Background="{StaticResource SecondaryBackgroundBrush}" Padding="12,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Images/Shoes.png" Height="42" Margin="0,0,16,0" Stretch="Uniform"/>
                <TextBlock x:Name="TitleText"
                           FontSize="24" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OrdersButton"
                        Content="Заказы"
                        Click="OrdersButton_Click"
                        Visibility="Collapsed"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="12,6"
                        Margin="0,0,10,0"/>

                <TextBlock x:Name="UserNameText"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <Button x:Name="ActionButton"
                        Click="ActionButton_Click"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="12,6"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>