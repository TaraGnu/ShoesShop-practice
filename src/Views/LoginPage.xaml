<Page x:Class="ShoesShop.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:ShoesShop.Views.Controls"
      Title="Вход в систему"
      FontFamily="Calibri"
      Background="{StaticResource PrimaryBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TopBarControl Grid.Row="0"
                        x:Name="TopBar"
                        Title="Вход в систему"
                        ShowAuthButton="False"
                        CatalogRequested="TopBar_CatalogRequested"/>

        <Border Grid.Row="2" Margin="25,70,25,25" HorizontalAlignment="Center">
            <Grid VerticalAlignment="Center" Width="350">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                       Text="Вход в систему"
                       FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

                <TextBlock Grid.Row="1"
                       Text="Логин"
                       FontSize="14"
                       Margin="0,0,0,6"/>

                <TextBox x:Name="LoginTextBox"
                     Grid.Row="2"
                     Text="{Binding LoginInput, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="LoginTextBox_KeyDown"
                     FontSize="15"
                     Padding="8"
                     Height="38"
                     VerticalContentAlignment="Center"/>

                <StackPanel Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                    <Button Content="Войти"
                        Click="LoginButton_Click"
                        IsDefault="True"
                        Height="40" Width="140"
                        HorizontalAlignment="Right"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="15"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
