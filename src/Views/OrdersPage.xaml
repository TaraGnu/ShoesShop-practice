<Page x:Class="ShoesShop.Views.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:controls="clr-namespace:ShoesShop.Views.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrdersPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:TopBarControl Grid.Row="0"
                                x:Name="TopBar"
                                Title="Заказы"
                                LoginRequested="TopBar_LoginRequested"
                                LogoutRequested="TopBar_LogoutRequested"
                                OrdersRequested="TopBar_OrdersRequested"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16">
            <Button Content="← Назад"
                    Click="Back_Click"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="14,8"
                    Margin="0,0,20,0"/>

            <Button Content="Добавить заказ"
                    Click="Add_Click"
                    Visibility="{Binding IsStaff, Converter={StaticResource BoolToVisibility}}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="14,8"
                    Margin="0,0,10,0"/>

            <Button Content="Открыть"
                    Click="Open_Click"
                    Padding="14,8"
                    Margin="0,0,10,0"/>

            <Button Content="Удалить"
                    Click="Delete_Click"
                    Visibility="{Binding IsStaff, Converter={StaticResource BoolToVisibility}}"
                    Padding="14,8"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="OrdersGrid"
                  ItemsSource="{Binding Orders}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="16"
                  RowHeaderWidth="0"
                  AlternatingRowBackground="{StaticResource SecondaryBackgroundBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№"
                                    Binding="{Binding Id}"
                                    Width="60"/>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date, StringFormat='dd.MM.yyyy HH:mm'}"
                                    Width="180"/>
                <DataGridTextColumn Header="Клиент"
                                    Binding="{Binding UserFullName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding TotalPrice, StringFormat='{}{0:N0} ₽'}"
                                    Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
