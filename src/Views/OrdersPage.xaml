<Page x:Class="ShoesShop.Views.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:ShoesShop.Views.Controls"
      Title="Заказы"
      FontFamily="Calibri"
      Background="{StaticResource PrimaryBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:TopBarControl Grid.Row="0"
                                x:Name="TopBar"
                                Title="Заказы"
                                ShowOrdersButton="False"
                                CatalogRequested="TopBar_CatalogRequested"
                                LoginRequested="TopBar_LoginRequested"
                                LogoutRequested="TopBar_LogoutRequested"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16">
            <Button Content="← Назад"
                    Click="Back_Click"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="14,8"
                    Margin="0,0,20,0"/>

            <Button Content="Добавить заказ"
                    Click="Add_Click"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="14,8"
                    Visibility="{Binding IsStaff, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
                  x:Name="OrdersGrid"
                  ItemsSource="{Binding Orders}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="16"
                  RowHeaderWidth="0"
                  AlternatingRowBackground="{StaticResource SecondaryBackgroundBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№"
                                    Binding="{Binding Id}"
                                    Width="60"/>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date, StringFormat='dd.MM.yyyy HH:mm'}"
                                    Width="180"/>
                <DataGridTextColumn Header="Клиент"
                                    Binding="{Binding UserFullName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding TotalPrice, StringFormat='{}{0:N0} ₽'}"
                                    Width="160"/>
                <DataGridTemplateColumn Header="Действия" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:OrderActionsControl
                                EditRequested="OrderRow_EditRequested"
                                DeleteRequested="OrderRow_DeleteRequested"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>