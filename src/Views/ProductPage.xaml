<Page x:Class="ShoesShop.Views.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:ShoesShop.Views.Controls"
      Title="Просмотр товара"
      FontFamily="Calibri"
      Background="{StaticResource PrimaryBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:TopBarControl Grid.Row="0"
                 x:Name="TopBar"
                 Title="Просмотр товара"
                 LoginRequested="TopBar_LoginRequested"
                 LogoutRequested="TopBar_LogoutRequested"
                 OrdersRequested="TopBar_OrdersRequested"
                 CatalogRequested="TopBar_CatalogRequested"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,12,16,0">
            <Button Content="← Назад" Click="Back_Click"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Padding="14,8"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Padding="16" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource ProductCardBorder}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="{Binding ImagePath}"
                               Width="300" Height="300" Stretch="Uniform"
                               VerticalAlignment="Top" Margin="0,0,24,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ProductionName}" FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,4,0,8"/>

                            <TextBlock FontSize="14" Margin="0,0,0,4">
                                <Run Text="Категория: " FontWeight="SemiBold"/>
                                <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding SubcategoryName, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock FontSize="14" Margin="0,0,0,4">
                                <Run Text="Состав: " FontWeight="SemiBold"/>
                                <Run Text="{Binding Material, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock FontSize="14" Margin="0,0,0,4">
                                <Run Text="Размерный ряд: " FontWeight="SemiBold"/>
                                <Run Text="{Binding SizeRange, Mode=OneWay}"/>
                            </TextBlock>

                            <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="{Binding PriceWithDiscount, StringFormat='{}{0:N0} ₽'}"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding BasePrice, StringFormat='{}{0:N0} ₽'}"
                                           FontSize="16" TextDecorations="Strikethrough"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Bottom" Margin="10,0,0,4"
                                           Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>

                            <TextBlock Text="Скидка 25% — товар не заказывался в прошлом месяце"
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ProductCardBorder}" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Оформление позиции" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="300">
                                <TextBlock Text="Размер" FontSize="13" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableSizes}"
                                    SelectedItem="{Binding SelectedSize}"
                                    DisplayMemberPath="Display"
                                    IsEnabled="{Binding HasAvailableSizes}"
                                    Padding="6" Height="34"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="20,0,0,0">
                                <TextBlock Text="Количество" FontSize="13" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6" Height="34"
                                         PreviewTextInput="Quantity_PreviewTextInput"/>
                            </StackPanel>
                            <Button Content="Добавить в заказ"
                                    Command="{Binding AddToCartCommand}"
                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                    BorderThickness="0" Padding="18,8" Height="34"
                                    VerticalAlignment="Bottom" Margin="20,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Нет доступных для заказа размеров"
                                   Foreground="#C0392B" FontSize="13" Margin="0,8,0,0"
                                   Visibility="{Binding IsEmptySizes, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>

                <!-- Корзина -->
                <Border Style="{StaticResource ProductCardBorder}" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Текущий заказ" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CartCount, StringFormat='Позиций: {0}'}"
                                       HorizontalAlignment="Right" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Cart}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SecondaryBackgroundBrush}"
                                            CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Display}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='×{0}'}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat='{}{0:N0} ₽'}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="Удалить"
                                                    Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#C0392B"
                                                    BorderThickness="0" Padding="10,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <TextBlock Text="Итого: " FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CartTotal, StringFormat='{}{0:N0} ₽'}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Очистить" Command="{Binding ClearCartCommand}"
                                    Background="Transparent" BorderThickness="1" Padding="16,8" Margin="0,0,10,0"/>
                            <Button Content="Подтвердить заказ" Command="{Binding ConfirmOrderCommand}"
                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                    BorderThickness="0" Padding="18,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>